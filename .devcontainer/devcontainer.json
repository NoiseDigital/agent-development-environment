{
    "name": "Agent Platform",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.devcontainer.yml"
    ],
    "service": "workspace",
    "runServices": ["workspace"],
    "shutdownAction": "none",
    "workspaceFolder": "/workspaces/agent-platform",
    "containerEnv": {
        "AGENT_PLATFORM_DEVCONTAINER": "1",
        "SHELL": "/bin/bash",
        "LANG": "C.UTF-8",
        "LANGUAGE": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
    },
    "forwardPorts": [8000, 5000, 5001, 5002, 3000, 5432],
    "portsAttributes": {
        "8000": {
            "label": "ADK Agent Server",
            "requireLocalPort": true,
            "onAutoForward": "openBrowserOnce"
        },
        "5000": {
            "label": "MCP Toolbox",
            "requireLocalPort": true
        },
        "5001": {
            "label": "MCP Google Ads",
            "requireLocalPort": true
        },
        "5002": {
            "label": "MCP Math",
            "requireLocalPort": true
        },
        "3000": {
            "label": "Frontend",
            "requireLocalPort": true,
            "onAutoForward": "openBrowserOnce"
        },
        "5432": {
            "label": "PostgreSQL",
            "requireLocalPort": true
        }
    },
    "postCreateCommand": "pre-commit install",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "HashiCorp.terraform",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "hediet.vscode-drawio",
                "bierner.markdown-preview-github-styles",
                "bierner.github-markdown-preview",
                "eamodio.gitlens",
                "DavidAnson.vscode-markdownlint"
            ]
        }
    },
    "remoteUser": "root"
}
