{
    "name": "Agent Platform",
    "runArgs": ["--name=agent-platform-devcontainer"],
    "privileged": true,
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": false,
            "version": "latest",
            "dockerDashComposeVersion": "v2",
            "installDockerBuildx": true
        }
    },
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "mounts": [
        {
            "source": "${localWorkspaceFolderBasename}_gcloud_config",
            "target": "/root/.config/gcloud",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "SHELL": "/bin/bash",
        "LANG": "C.UTF-8",
        "LANGUAGE": "C.UTF-8",
        "LC_ALL": "C.UTF-8"
    },
    "forwardPorts": [8000, 5000, 3000, 5432],
    "portsAttributes": {
        "8000": {
            "label": "ADK Agent Server",
            "requireLocalPort": true,
            "onAutoForward": "openBrowserOnce"
        },
        "5000": {
            "label": "MCP Toolbox",
            "requireLocalPort": true
        },
        "3000": {
            "label": "Frontend",
            "requireLocalPort": true,
            "onAutoForward": "openBrowserOnce"
        },
        "5432": {
            "label": "PostgreSQL",
            "requireLocalPort": true
        }
    },
    "postCreateCommand": "pre-commit install",
    "postAttachCommand": {
        "services": "bash ${containerWorkspaceFolder}/scripts/start_services.sh"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "HashiCorp.terraform",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "hediet.vscode-drawio",
                "bierner.markdown-preview-github-styles",
                "bierner.github-markdown-preview"
            ]
        }
    },
    "remoteUser": "root"
}
