__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.local
.venv
# Anchored to repo root so it ignores a top-level data/ dump only —
# a bare "data" also swallowed source dirs like frontend/src/data/.
/data
.env
.vscode/settings.json
.DS_Store

# Credential files — never commit keys or ADC files
*.pem
*.key
*service-account*.json
*-credentials.json
application_default_credentials.json

# Terraform — ignore the entire .terraform working dir, not a versioned binary path
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
