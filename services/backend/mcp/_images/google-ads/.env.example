# Google Ads MCP Server — environment variables
# Copy this file to .env in the same directory and fill in your values.
# .env is gitignored. Never commit real credentials.

# Required: your GCP project ID
GOOGLE_PROJECT_ID=YOUR_PROJECT_ID

# Required: 22-character Google Ads developer token (get from Google Ads API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_DEVELOPER_TOKEN

# OAuth proxy mode (enables streamable-http transport for compose/cloud hosting)
# Both must be set to activate HTTP mode; omit both to fall back to stdio.
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

# Base URL where this server is reachable (used in OAuth redirect URIs)
# For local compose: http://localhost:5001
# For Cloud Run: the assigned *.run.app URL
GOOGLE_ADS_MCP_BASE_URL=http://localhost:5001

# Optional: manager account customer ID (if accessing accounts via MCC)
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=YOUR_MANAGER_CUSTOMER_ID
