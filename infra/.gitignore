# Terraform — never commit state, provider binaries, or plans.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Commit lock files (.terraform.lock.hcl) and the per-env terraform.tfvars
# (non-secret config: github owner/repo, flags). Real SECRETS (e.g.
# google_oauth_client_secret) must NOT be committed — put them in a
# *.auto.tfvars override (ignored below) or pass TF_VAR_* in the environment.
bootstrap/terraform.tfvars
*.auto.tfvars
