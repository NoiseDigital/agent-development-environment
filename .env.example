# Copy this file to .env to get started. Values are pre-filled for local dev.
# .env is gitignored — credentials and personal overrides stay local.

# ── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=nd-agentspace-sbx
GOOGLE_CLOUD_LOCATION=northamerica-northeast1
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional: use IAM service account impersonation for gcloud/ADC operations.
# Users must have iam.serviceAccountTokenCreator on this service account.
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=

# ── Service ports (override defaults if needed) ───────────────────────────────
AGENT_PORT=8000
MCP_PORT=5000
MATH_MCP_PORT=5002
ASANA_MCP_PORT=5003
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/postgres

# ── CORS / networking ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://frontend:3000
ENVIRONMENT=development

# ── Agents ───────────────────────────────────────────────────────────────────
# URL the browser uses to reach the ADK agent server. Must be prefixed NEXT_PUBLIC_
# so Next.js includes it in the client bundle. Set to http://localhost:8000 for
# local dev, or a Cloud Run URL for production. Remove to use per-agent URLs in agentConfig.tsx.
NEXT_PUBLIC_AGENTS_BASE_URL=http://localhost:8000
# Internal URL used by the agent container to reach the MCP Toolbox service.
TOOLBOX_ENDPOINT=http://mcp-toolbox:5000


# ── Frontend ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Optional MCP profile wiring (control-plane vars) ─────────────────────────
# These vars do NOT contain Google Ads credentials. They only tell the startup
# scripts where to fetch the credentials blob from Secret Manager.
#
# Secret payload must be dotenv content compatible with:
# services/backend/mcp/images/google-ads/.env.example
#
# If unset, core services still start normally and google-ads profile remains
# disabled until configured.
GOOGLE_ADS_MCP_ENV_SECRET_NAME=
GOOGLE_ADS_MCP_ENV_SECRET_PROJECT=
GOOGLE_ADS_MCP_ENV_SECRET_VERSION=latest

# ── Asana MCP ─────────────────────────────────────────────────────────────────
# Personal access token from https://app.asana.com/0/my-apps
# Required to start the asana profile. Lives only in your local .env.
ASANA_ACCESS_TOKEN=
# Optional: pin a workspace GID. Defaults to the first workspace on the token.
ASANA_WORKSPACE_GID=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=http://localhost:8000/auth/asana/callback
ASANA_SCOPES="tasks:read tasks:write projects:read users:read"
NEXT_PUBLIC_ASANA_CLIENT_ID=
