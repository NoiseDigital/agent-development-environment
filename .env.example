# Copy this file to .env to get started. Values are pre-filled for local dev.
# .env is gitignored — credentials and personal overrides stay local.

# ── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=nd-agentspace-sbx
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Optional: use IAM service account impersonation for gcloud/ADC operations.
# Users must have iam.serviceAccountTokenCreator on this service account.
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=

# ── Service ports (override defaults if needed) ───────────────────────────────
AGENT_PORT=8000
MCP_PORT=5000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/postgres

# ── CORS / networking ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://frontend:3000
ENVIRONMENT=development

# ── Backend URLs ──────────────────────────────────────────────────────────────
# URL the browser uses to reach the public gateway. The gateway owns the
# platform's API surface (dashboards, clients, auth) and proxies ADK traffic
# (sessions, /run_sse) to the private agent service. NEXT_PUBLIC_ prefix is
# required for Next.js to include the value in the client bundle.
#
# IMPORTANT: as of the gateway migration, point this at port 8080 (gateway),
# NOT 8000 (agent). The agent is reachable via the gateway proxy.
NEXT_PUBLIC_AGENTS_BASE_URL=http://localhost:8080
# Internal URL used by the gateway + agent containers to reach the MCP Toolbox.
TOOLBOX_ENDPOINT=http://mcp-toolbox:5000


# ── Frontend ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Analytics / server-side tagging (optional) ───────────────────────────────
# The GA4 measurement id (gtag.js) is NOT set here — it's baked PER-TENANT in
# tenants/<id>.json (analytics.measurementId) so no tenant can inherit another's
# property. To test tagging locally, set that tenant's id in its manifest and
# re-run `node scripts/gen-tenant-config.mjs` (noise sbx stream is G-PSTSB8D377).
# Empty id = analytics is a no-op.
# Where gtag posts measurement data (environment-specific relay). Leave empty to
# send straight to Google, or point at the local sGTM service to route through it:
#   NEXT_PUBLIC_GA_SERVER_CONTAINER_URL=http://localhost:8090
NEXT_PUBLIC_GA_SERVER_CONTAINER_URL=
# sGTM (`docker compose --profile tagging up`). CONTAINER_CONFIG comes from a GTM
# *Server* container (tagmanager.google.com → Admin → Create Container → Server).
# Without it the sgtm container won't start, which is why it's profile-gated.
SGTM_PORT=8090
SGTM_CONTAINER_CONFIG=

# ── Optional MCP profile wiring (control-plane vars) ─────────────────────────
# These vars do NOT contain Google Ads credentials. They only tell the startup
# scripts where to fetch the credentials blob from Secret Manager.
#
# Secret payload must be dotenv content compatible with:
# services/backend/mcp/images/google-ads/.env.example
#
# If unset, core services still start normally and google-ads profile remains
# disabled until configured.
GOOGLE_ADS_MCP_ENV_SECRET_NAME=
GOOGLE_ADS_MCP_ENV_SECRET_PROJECT=
GOOGLE_ADS_MCP_ENV_SECRET_VERSION=latest
